# Imager profile — rendered by scripts/gen-profile.sh (envsubst).
# Two artifacts are produced from this same profile by flipping OUTPUT_KIND:
#   - kind: iso        -> metal-${ARCH}.iso   (USB fresh install)
#   - kind: installer  -> installer image     (talosctl upgrade --image ...)
arch: ${ARCH}
platform: metal
secureboot: false
name: Talos
version: ${TALOS_VERSION}
input:
  kernel:
    path: /usr/install/${ARCH}/vmlinuz
  initramfs:
    path: /usr/install/${ARCH}/initramfs.xz
  sdStub:
    path: /usr/install/${ARCH}/systemd-stub.efi
  sdBoot:
    path: /usr/install/${ARCH}/systemd-boot.efi
  baseInstaller:
    # installer-base built from siderolabs/talos against the CUSTOM (GCC-linked) kernel
    imageRef: ${REGISTRY}/imager/installer-base:${TALOS_VERSION}
output:
  kind: ${OUTPUT_KIND}
  outFormat: ${OUTPUT_FORMAT}

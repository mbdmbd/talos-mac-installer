# Fallback inputs for local runs and workflow_dispatch. A workflow_dispatch input
# can override TALOS_VERSION without changing this file. Renovate tracks the
# stable Talos release declared below (renovate.json).

# Talos release to build. The pkgs ref is NOT set here — scripts/build.sh reads the
# exact pkgs commit that this Talos release pins (Makefile `PKGS ?= v1.13.0-N-gSHA`),
# which avoids the branch-drift kernel-checksum mismatch.
TALOS_VERSION=v1.13.9

# amd64 only — these are Intel Macs.
PLATFORM=linux/amd64
ARCH=amd64

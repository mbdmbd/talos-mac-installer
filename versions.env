# Fallback inputs for local runs / workflow_dispatch. On a tag push the workflow
# overrides TALOS_VERSION with the pushed tag. Renovate tracks these (renovate.json).

# Talos release to build. The pkgs ref is NOT set here — build.sh reads the exact pkgs
# commit that this talos release pins (Makefile `PKGS ?= v1.13.0-N-gSHA`), which avoids
# the branch-drift kernel-checksum mismatch.
TALOS_VERSION=v1.13.7

# amd64 only — these are Intel Macs.
PLATFORM=linux/amd64
ARCH=amd64
